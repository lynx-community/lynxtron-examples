{
  "name": "@lynxtron-examples/native-texture-canvas",
  "version": "0.0.5",
  "main": "main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-community/lynxtron-examples",
    "directory": "showcases/native-texture-canvas"
  },
  "files": [
    "dist/desktop/**/*",
    "native-texture-extension/bindings/**/*",
    "native-texture-extension/module/**/*",
    "native-texture-extension/scripts/**/*",
    "native-texture-extension/CMakeLists.txt",
    "native-texture-extension/index.cjs",
    "native-texture-extension/package.json",
    "native-texture-extension/lynx.lib.json",
    "src/**/*",
    "lynx.config.ts",
    "preview-image.webp",
    "rspack.config.ts",
    "thumbnail.svg",
    "thumbnail.png",
    "tsconfig.tools.json"
  ],
  "scripts": {
    "test:autolink": "npm run build && node --test autolink.test.cjs",
    "build:native-texture": "node native-texture-extension/scripts/build.js",
    "build": "npm run build:native-texture && rspeedy build && rspack build",
    "dev": "npm run build:native-texture && cross-env TARGET_ENV=desktop NODE_ENV=development concurrently -k --raw \"rspeedy dev\" \"dev-ready-rspeedy && rspack dev\"",
    "start": "cross-env TARGET_ENV=desktop npm run build && lynxtron ./dist/desktop"
  },
  "showcase": {
    "description": "Native Texture Canvas extension showcase with Lynx controls and a native drawing surface",
    "tags": [
      "native",
      "texture",
      "canvas",
      "painting"
    ],
    "minToolchainVersion": "0.0.1"
  },
  "dependencies": {
    "@lynx-js/lynxtron": "catalog:",
    "lynxtron-native-texture-canvas": "file:./native-texture-extension"
  },
  "devDependencies": {
    "@lynx-js/lynx-library-headers": "catalog:",
    "@lynx-js/lynxtron-dev-plugins": "catalog:",
    "@lynx-js/react": "catalog:",
    "@lynx-js/rspeedy": "catalog:",
    "@lynx-js/types": "catalog:",
    "@lynxtron-examples/config": "workspace:*",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@types/node": "^22.20.0",
    "cmake-js": "^7.3.0",
    "concurrently": "catalog:",
    "cross-env": "catalog:",
    "node-addon-api": "^7.0.0",
    "typescript": "catalog:"
  }
}

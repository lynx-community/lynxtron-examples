{
  "name": "@lynxtron-examples/codex-demo",
  "version": "0.0.1",
  "main": "main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-community/lynxtron-examples",
    "directory": "showcases/codex-demo"
  },
  "scripts": {
    "prepare:computer-use": "node scripts/prepare-computer-use-runtime.mjs",
    "prepare:opencode": "node scripts/prepare-opencode-runtime.mjs",
    "smoke:computer-use": "node scripts/smoke-computer-use-mcp.mjs",
    "build": "pnpm run prepare:computer-use && pnpm run prepare:opencode && rspeedy build && rspack build",
    "dev": "pnpm run prepare:computer-use && pnpm run prepare:opencode && cross-env TARGET_ENV=desktop NODE_ENV=development concurrently -k --raw \"rspeedy dev\" \"dev-ready-rspeedy && rspack dev\"",
    "start": "cross-env TARGET_ENV=desktop pnpm run build && lynxtron ./dist/desktop",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p src/app/tsconfig.json && tsc --noEmit -p src/main/desktop/tsconfig.json"
  },
  "showcase": {
    "description": "Agent-neutral Codex-style desktop client with OpenCode ACP integration",
    "thumbnail": "thumbnail.png",
    "tags": [
      "agent",
      "developer-tools",
      "opencode"
    ],
    "minToolchainVersion": "0.0.8"
  },
  "dependencies": {
    "@lynx-js/lynxtron": "catalog:",
    "open-computer-use": "0.3.1"
  },
  "devDependencies": {
    "@lynxtron-examples/config": "workspace:*",
    "@lynx-js/react": "catalog:",
    "@lynx-js/rspeedy": "catalog:",
    "@lynx-js/types": "catalog:",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@lynx-js/lynxtron-dev-plugins": "catalog:",
    "@types/node": "^22.0.0",
    "concurrently": "catalog:",
    "cross-env": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
